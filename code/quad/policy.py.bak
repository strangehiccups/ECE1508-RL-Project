import torch
import torch.nn as nn


class RunningNorm:
    """Running mean/std observation normalizer on the GPU."""
    def __init__(self, dim, device):
        self.mean = torch.zeros(dim, device=device)
        self.var = torch.ones(dim, device=device)
        self.count = 1e-4

    def update(self, x):
        b_mean, b_var, b_n = x.mean(0), x.var(0), x.shape[0]
        delta = b_mean - self.mean
        tot = self.count + b_n
        self.mean = self.mean + delta * b_n / tot
        m2 = self.var * self.count + b_var * b_n + delta**2 * self.count * b_n / tot
        self.var = m2 / tot
        self.count = tot

    def __call__(self, x):
        return ((x - self.mean) / torch.sqrt(self.var + 1e-8)).clamp(-10, 10)


def norm_hist(hist, norm):
    """Normalize the state part of a raw history (B, T, 22) with the (frozen) obs normalizer.
    The first 18 obs dims are x_t, so norm.mean[:18] / norm.var[:18] apply. Actions are left as is."""
    x = ((hist[..., :STATE_DIM] - norm.mean[:STATE_DIM])
         / torch.sqrt(norm.var[:STATE_DIM] + 1e-8)).clamp(-10, 10)
    return torch.cat([x, hist[..., STATE_DIM:]], dim=-1)


# ---- (1) environment factor encoder:  e_t -> z_t ----------------------
class EnvEncoder(nn.Module):
    """3-layer MLP. Only used in training as the 'expert'."""
    def __init__(self, env_dim=7,
                 hidden_dim1=256, hidden_dim2=128,
                 z_dim=8):
        super().__init__()
        self.net = nn.Sequential(nn.Linear(env_dim, hidden_dim1), nn.ELU(),
                                 nn.Linear(hidden_dim1, hidden_dim2), nn.ELU(),
                                 nn.Linear(hidden_dim2, z_dim))

    def forward(self, e):
        return self.net(e)


# ---- (2) base policy:  (x_t, a_{t-1}, z_t) -> a_t  --------------------
class ActorCritic(nn.Module):
    """Base Policy"""
    def __init__(self, obs_dim=22,
                 hidden_dim1=128, hidden_dim2=128, 
                 z_dim=8, act_dim=4):
        super().__init__()
        def mlp(out):
            return nn.Sequential(nn.Linear(obs_dim + z_dim, hidden_dim1), nn.ELU(),
                                 nn.Linear(hidden_dim1, hidden_dim2), nn.ELU(),
                                 nn.Linear(hidden_dim2, out))
        self.actor, self.critic = mlp(act_dim), mlp(1)
        self.log_std = nn.Parameter(torch.full((act_dim,), -1.0))

    def dist(self, obs, z):
        return torch.distributions.Normal(self.actor(obs), self.log_std.exp())

    def value(self, obs):
        return self.critic(obs).squeeze(-1)