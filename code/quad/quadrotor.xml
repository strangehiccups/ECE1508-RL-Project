<mujoco model="quadrotor">
  <!-- Euler: IMPLICITFAST is not supported by MJWarp -->
  <option timestep="0.002" integrator="Euler" gravity="0 0 -9.81"/>

  <!-- visual only: none of the elements below change the physics -->
  <statistic center="0 0 0.9" extent="0.4"/>
  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6" specular="0.1 0.1 0.1"/>
    <global azimuth="135" elevation="-25"/>
  </visual>
  <asset>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.55 0.7 0.9" rgb2="0.15 0.2 0.3" width="256" height="256"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.8 0.8 0.8" rgb2="0.6 0.6 0.6" width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="20 20"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" diffuse="0.5 0.5 0.5"/>
    <geom name="floor" type="plane" size="5 5 0.1" material="grid"/>
    <!-- green ball = hover target (sites have no physics) -->
    <site name="target" pos="0 0 1" size="0.01" rgba="0.1 0.8 0.2 0.8"/>

    <body name="drone" pos="0 0 1">
      <freejoint name="root"/>
      <inertial pos="0 0 0" mass="0.027" diaginertia="1.4e-5 1.4e-5 2.17e-5"/>

      <geom name="body" type="box" size="0.03 0.03 0.01" rgba="0.2 0.4 0.9 1" mass="0"/>
      <!-- visual-only arms and propellers (contype/conaffinity 0 = no collisions, mass 0);
           front propellers (+x) are red so you can see heading and tilt -->
      <geom type="capsule" fromto="-0.028 -0.028 0.012  0.028 0.028 0.012" size="0.003" rgba="0.2 0.2 0.2 1" contype="0" conaffinity="0" mass="0"/>
      <geom type="capsule" fromto="-0.028 0.028 0.012  0.028 -0.028 0.012" size="0.003" rgba="0.2 0.2 0.2 1" contype="0" conaffinity="0" mass="0"/>
      <geom type="cylinder" pos=" 0.028  0.028 0.016" size="0.02 0.001" rgba="0.9 0.2 0.2 0.6" contype="0" conaffinity="0" mass="0"/>
      <geom type="cylinder" pos="-0.028  0.028 0.016" size="0.02 0.001" rgba="0.3 0.3 0.3 0.6" contype="0" conaffinity="0" mass="0"/>
      <geom type="cylinder" pos="-0.028 -0.028 0.016" size="0.02 0.001" rgba="0.3 0.3 0.3 0.6" contype="0" conaffinity="0" mass="0"/>
      <geom type="cylinder" pos=" 0.028 -0.028 0.016" size="0.02 0.001" rgba="0.9 0.2 0.2 0.6" contype="0" conaffinity="0" mass="0"/>

      <site name="m1" pos=" 0.028  0.028 0" size="0.004"/>
      <site name="m2" pos="-0.028  0.028 0" size="0.004"/>
      <site name="m3" pos="-0.028 -0.028 0" size="0.004"/>
      <site name="m4" pos=" 0.028 -0.028 0" size="0.004"/>
    </body>
  </worldbody>

  <actuator>
    <!-- gear = fx fy fz tx ty tz in the site frame; ctrl is thrust in newtons -->
    <motor name="u1" site="m1" gear="0 0  1 0 0  0.006" ctrlrange="0 0.15"/>
    <motor name="u2" site="m2" gear="0 0  1 0 0 -0.006" ctrlrange="0 0.15"/>
    <motor name="u3" site="m3" gear="0 0  1 0 0  0.006" ctrlrange="0 0.15"/>
    <motor name="u4" site="m4" gear="0 0  1 0 0 -0.006" ctrlrange="0 0.15"/>
  </actuator>
</mujoco>
