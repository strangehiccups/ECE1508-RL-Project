<mujoco model="quadrotor">
  <!-- Euler: IMPLICITFAST is not supported by MJWarp -->
  <option timestep="0.002" integrator="Euler" gravity="0 0 -9.81"/>

  <worldbody>
    <geom name="floor" type="plane" size="5 5 0.1" rgba="0.8 0.8 0.8 1"/>

    <body name="drone" pos="0 0 1">
      <freejoint name="root"/>
      <inertial pos="0 0 0" mass="0.027" diaginertia="1.4e-5 1.4e-5 2.17e-5"/>

      <!-- visual / collision proxy; replace with your CAD mesh later (contype=0 conaffinity=0) -->
      <geom name="body" type="box" size="0.03 0.03 0.01" rgba="0.2 0.4 0.9 1" mass="0"/>

      <site name="m1" pos=" 0.028  0.028 0" size="0.004"/>
      <site name="m2" pos="-0.028  0.028 0" size="0.004"/>
      <site name="m3" pos="-0.028 -0.028 0" size="0.004"/>
      <site name="m4" pos=" 0.028 -0.028 0" size="0.004"/>
    </body>
  </worldbody>

  <actuator>
    <!-- gear = fx fy fz tx ty tz in the site frame; ctrl is thrust in newtons -->
    <motor name="u1" site="m1" gear="0 0  1 0 0  0.006" ctrlrange="0 0.15"/>
    <motor name="u2" site="m2" gear="0 0  1 0 0 -0.006" ctrlrange="0 0.15"/>
    <motor name="u3" site="m3" gear="0 0  1 0 0  0.006" ctrlrange="0 0.15"/>
    <motor name="u4" site="m4" gear="0 0  1 0 0 -0.006" ctrlrange="0 0.15"/>
  </actuator>
</mujoco>